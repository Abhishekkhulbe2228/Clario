# ─── Clario Environment Configuration ────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Application ──────────────────────────────────────────────────────────
APP_NAME=Clario
ENVIRONMENT=development

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/clario.db

# ─── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Authentication (JWT) ─────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret

# ─── Bootstrap Admin Account ─────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-min-12-chars

# ─── Bootstrap Employee Account ──────────────────────────────────────────
BOOTSTRAP_EMPLOYEE_EMAIL=employee@company.com
BOOTSTRAP_EMPLOYEE_PASSWORD=replace-with-a-strong-password-min-12-chars

# ─── LLM Provider (Groq) ─────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ─── Embeddings ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Vector Database (Pinecone) ───────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hr-policy-rag
PINECONE_NAMESPACE=company-hr-kb

# ─── Web Search (Tavily) ─────────────────────────────────────────────────
TAVILY_API_KEY=

# ─── Docker / Production (only needed with docker-compose) ────────────────
# POSTGRES_PASSWORD=replace-with-postgres-password
